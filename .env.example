# Public frontend configuration only. Copy to .env.local.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# Optional public Devnet RPC; defaults to the official endpoint. Never put a private RPC key here.
VITE_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
