# Copy to supabase/.env.local for function development/secrets import; never commit.
# Hosted Supabase functions already receive SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# For local serve, the Supabase CLI supplies the local versions automatically.
ADMIN_WALLET_ADDRESS=YOUR_CHOSEN_PUBLIC_PHANTOM_ADDRESS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4174
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
